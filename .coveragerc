[run]
source = back/app
omit = 
    back/app/main.py
    back/app/print_recent_actions.py
    back/app/database.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
